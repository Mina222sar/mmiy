@echo off
chcp 65001 > nul
title تسجيل الدخول ونشر الموقع على Firebase أونلاين
cls
echo ================================================================
echo   اعتماد ونشر نظام الحضور أونلاين على السحابة (Firebase)
echo   كنيسة مارمينا العجايبي بكوم المحرص — إعداد خدام
echo ================================================================
echo.
echo [الخطوة 1/2] سيتم الآن فتح المتصفح لتسجيل الدخول بحساب Google الخاص بك...
echo  (يرجى اختيار حسابك والموافقة على الصلاحية)
echo.
pause
call npx -y firebase-tools@latest login
echo.
echo ================================================================
echo [الخطوة 2/2] جاري رفع ونشر الموقع أونلاين على سيرفرات Google Cloud...
echo ================================================================
echo.
call npx -y firebase-tools@latest deploy --only hosting,firestore --project qrcode-bbb68
echo.
echo ================================================================
echo  🎉 تم اعتماد ونشر الموقع بنجاح!
echo  🌐 رابط الموقع المباشر: https://qrcode-bbb68.web.app
echo ================================================================
echo.
pause
